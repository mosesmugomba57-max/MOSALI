# ================================
# MOSALI BACKEND - API KEYS
# ================================
# Copy this file to .env and fill in your keys

PORT=5000

# BEST API RECOMMENDATION: TMDB (The Movie Database)
# Sign up free: https://www.themoviedb.org/settings/api
# Get your API Key (v3 auth) and paste below
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: OMDb (simpler lookup by title/IMDb ID)
# Get free key: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Base URL used by frontend (do not change unless you change ports)
FRONTEND_ORIGIN=http://localhost:5173
